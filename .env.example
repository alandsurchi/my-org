# Copy to .env for local development. Nothing here is required.

# Where /api and /uploads are proxied to when running `npm run dev` or `npm run preview`.
# Defaults to the production backend on Railway. Use http://localhost:5000 for a local backend.
BACKEND_URL=https://charity-backend-production-944a.up.railway.app

# Optional: hidden path that redirects to the staff login page (default: log-org)
# VITE_SECRET_STAFF_PATH=log-org

# Do NOT set VITE_API_URL. The app uses the relative /api path, which is proxied
# by Vite locally and by server.mjs on Railway.
