# Copy to .env. Vite only exposes variables prefixed with VITE_.

# Backend API base URL (must end with /api)
# Leave unset in production on Railway (defaults to /api, proxied by server.mjs).
# For local dev against a local backend:
VITE_API_URL=http://localhost:5000/api

# Optional: host that serves uploaded images when the API returns relative /uploads paths.
# Defaults to the API host. Set to your Cloudflare R2 public URL if STORAGE_TYPE=r2 on the backend.
# VITE_CDN_URL=https://pub-xxxx.r2.dev

# Optional: hidden path that redirects to the staff login page
VITE_SECRET_STAFF_PATH=log-org
