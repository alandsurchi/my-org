# Copy to .env for local development. In production set these in Railway → Variables.

# Required
DATABASE_URL=postgresql://postgres:password@localhost:5432/charity
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Server
PORT=5000
NODE_ENV=development
STAFF_SESSION_TIMEOUT=1h

# CORS: any origin is accepted by default. To restrict, set both of these.
CORS_STRICT=false
ALLOWED_ORIGINS=

# First super admin (only used when the database has no super admin yet).
# If DEFAULT_ADMIN_PASSWORD is unset a random password is generated and printed once in the logs.
DEFAULT_ADMIN_EMAIL=admin@charity.com
DEFAULT_ADMIN_PASSWORD=

# Optional: extra emails that are always treated as super admins (comma separated)
SUPER_ADMINS=

# Uploads. local = disk (Railway volume mounted at STORAGE_PATH), r2 = Cloudflare R2
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# Public host used to build absolute upload URLs when STORAGE_TYPE=local (Railway sets this automatically)
RAILWAY_PUBLIC_DOMAIN=

# Cloudflare R2 (only when STORAGE_TYPE=r2)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
